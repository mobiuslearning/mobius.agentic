---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResourceGrid from '../../components/ResourceGrid.astro';
import { resourceTypes, typeMeta, type ResourceType } from '../../lib/resources';

export function getStaticPaths() {
  return resourceTypes.map((type) => ({ params: { type } }));
}

const type = Astro.params.type as ResourceType;
const meta = typeMeta[type];
const resources = (await getCollection(type))
  .map((entry) => ({ ...entry, type }))
  .sort((a, b) => b.data.updatedAt.getTime() - a.data.updatedAt.getTime());
---

<BaseLayout title={`${meta.label} · Agentic`} description={meta.description}>
  <section class="collection-head shell">
    <a class="breadcrumb" href="/">← 全部资源</a>
    <div class="collection-heading">
      <span class={`collection-mark type-${type}`} aria-hidden="true">{meta.mark}</span>
      <div>
        <div class="eyebrow"><span></span> AGENTIC / {meta.label.toUpperCase()}</div>
        <h1>{meta.label}</h1>
        <p>{meta.description}</p>
      </div>
      <strong>{resources.length.toString().padStart(2, '0')}</strong>
    </div>
  </section>
  <div class="shell">
    <ResourceGrid resources={resources} initialType={type} showTypeFilters={false} />
  </div>
</BaseLayout>
